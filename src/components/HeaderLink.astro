---
type Props = {
  href: string;
};

const { href } = Astro.props;
const pathname = Astro.url.pathname;
const isActive =
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(`${href}/`);
---

<a
  href={href}
  class:list={[
    "text-lg font-semibold tracking-wide",
    isActive ? "text-primary" : "text-foreground",
  ]}
>
  <slot />
</a>
